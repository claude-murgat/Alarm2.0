# /etc/sudoers.d/alarm-cd
# NOPASSWD scope aux SEULES commandes du flux CD V1 (cf docs/CD_DESIGN.md §3
# et brief Phase 3). Permet l'install + le pilotage d'alarm-cd-pull par le user
# `alarm` (donc via SSH non-interactif depuis un poste d'admin), sans accorder
# `NOPASSWD: ALL` qui ouvrirait le passwordless sur tout le systeme.
#
# Pourquoi ce fichier existe :
#   Le brief Phase 3 utilise `sudo install ...` et `sudo systemctl ...` pour
#   deployer alarm-cd-pull.{sh,service,timer}. Sur NODE3 cloud OVH le user
#   `alarm` a `(ALL) NOPASSWD: ALL` (heritage du provisioning cloud, cf
#   §22ter), ce qui marche mais est trop large. Sur onsite-1 et onsite-2
#   `alarm` est dans le groupe sudo SANS NOPASSWD, ce qui bloque les commandes
#   non-interactives. Ce fichier comble le gap de maniere chirurgicale.
#
# Deploiement : infra/onsite/install.sh (donc alarm-host-sync a chaque commit :stable)
# copie ce fichier dans un temporaire root, le lint (`visudo -c -q -f`) et pose CETTE copie
# en 440 dans /etc/sudoers.d/alarm-cd ; si visudo refuse, rien n'est pose (l'ancienne reste,
# une sudoers cassee bloquerait tout `sudo` sur le noeud) et install.sh continue le reste.
# La CI (cd-install-smoke.yml) lint aussi ce fichier.
# Confiance : la source est le checkout /opt/alarm (owner alarm), comme les scripts root que
# alarm-host-sync y installe deja (/usr/local/bin/alarm-host-sync, install.sh lui-meme) :
# ce fichier n'elargit pas ce que `alarm` peut deja faire executer en root.
# Verification non-interactive depuis un poste d'admin :
#   ssh alarm@<noeud> "sudo -n systemctl status alarm-cd-pull.timer"
# doit marcher sans demander de mot de passe.
#
# ALARM_CHAOS (INV-177/178, mode netcut) : le runner alarm-chaos.sh (NODE3) coupe le
# tunnel wg0 d'un noeud via `sudo -n /usr/local/bin/alarm-chaos-net cut <s>` ; le
# helper (root) valide ses arguments (decimal strict 60..720) et arme d'abord le timer de
# restauration sur le noeud lui-meme. Pas de motif d'arguments ici : le helper est seul juge.
#
# Wildcards (`*`) :
#   En sudo, `*` matche tout y compris `/` (different du glob shell). On
#   l'utilise pour les modes d'install (444/644/755) et les options dynamiques
#   de journalctl --since. Le risque residuel d'evasion est faible — `alarm`
#   est deja un user privilegie (groupe sudo, groupe docker), une compromise
#   de ce user contourne deja largement ce filet.

Cmnd_Alias ALARM_CD_INSTALL = \
    /usr/bin/install -m * /usr/local/bin/alarm-cd-pull, \
    /usr/bin/install -m * /usr/local/bin/alarm-cd-orchestrate, \
    /usr/bin/install -m * /etc/systemd/system/alarm-cd-pull.service, \
    /usr/bin/install -m * /etc/systemd/system/alarm-cd-pull.timer, \
    /usr/bin/install -m * /etc/systemd/system/alarm-cd-orchestrate.service, \
    /usr/bin/install -m * /etc/systemd/system/alarm-cd-orchestrate.timer

Cmnd_Alias ALARM_CD_SYSTEMCTL = \
    /usr/bin/systemctl daemon-reload, \
    /usr/bin/systemctl enable alarm-cd-pull.timer, \
    /usr/bin/systemctl enable --now alarm-cd-pull.timer, \
    /usr/bin/systemctl disable alarm-cd-pull.timer, \
    /usr/bin/systemctl disable --now alarm-cd-pull.timer, \
    /usr/bin/systemctl start alarm-cd-pull.service, \
    /usr/bin/systemctl start alarm-cd-pull.timer, \
    /usr/bin/systemctl stop alarm-cd-pull.service, \
    /usr/bin/systemctl stop alarm-cd-pull.timer, \
    /usr/bin/systemctl restart alarm-cd-pull.service, \
    /usr/bin/systemctl restart alarm-cd-pull.timer, \
    /usr/bin/systemctl status alarm-cd-pull.service, \
    /usr/bin/systemctl status alarm-cd-pull.timer, \
    /usr/bin/systemctl is-enabled alarm-cd-pull.timer, \
    /usr/bin/systemctl is-active alarm-cd-pull.timer, \
    /usr/bin/systemctl cat alarm-cd-pull.service, \
    /usr/bin/systemctl cat alarm-cd-pull.timer, \
    /usr/bin/systemctl reset-failed alarm-cd-pull.service, \
    /usr/bin/systemctl reset-failed alarm-cd-pull.timer, \
    /usr/bin/systemctl enable alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl enable --now alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl disable alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl disable --now alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl start alarm-cd-orchestrate.service, \
    /usr/bin/systemctl start alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl stop alarm-cd-orchestrate.service, \
    /usr/bin/systemctl stop alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl restart alarm-cd-orchestrate.service, \
    /usr/bin/systemctl restart alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl status alarm-cd-orchestrate.service, \
    /usr/bin/systemctl status alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl is-enabled alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl is-active alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl cat alarm-cd-orchestrate.service, \
    /usr/bin/systemctl cat alarm-cd-orchestrate.timer, \
    /usr/bin/systemctl reset-failed alarm-cd-orchestrate.service, \
    /usr/bin/systemctl reset-failed alarm-cd-orchestrate.timer

Cmnd_Alias ALARM_CD_JOURNAL = \
    /usr/bin/journalctl -u alarm-cd-pull, \
    /usr/bin/journalctl -u alarm-cd-pull *, \
    /usr/bin/journalctl -u alarm-cd-pull.service, \
    /usr/bin/journalctl -u alarm-cd-pull.service *, \
    /usr/bin/journalctl -u alarm-cd-pull.timer, \
    /usr/bin/journalctl -u alarm-cd-pull.timer *, \
    /usr/bin/journalctl -u alarm-cd-orchestrate, \
    /usr/bin/journalctl -u alarm-cd-orchestrate *, \
    /usr/bin/journalctl -u alarm-cd-orchestrate.service, \
    /usr/bin/journalctl -u alarm-cd-orchestrate.service *, \
    /usr/bin/journalctl -u alarm-cd-orchestrate.timer, \
    /usr/bin/journalctl -u alarm-cd-orchestrate.timer *

Cmnd_Alias ALARM_CHAOS = /usr/local/bin/alarm-chaos-net

alarm ALL=(root) NOPASSWD: ALARM_CD_INSTALL, ALARM_CD_SYSTEMCTL, ALARM_CD_JOURNAL, ALARM_CHAOS
