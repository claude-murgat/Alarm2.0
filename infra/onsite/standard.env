# infra/onsite/standard.env — machine standard sur site (docs/STANDARD_MACHINE.md) : valeurs attendues.
# Lu par alarm-node-check (scripts/alarm-node-check.sh, INV-186 ; pose par infra/onsite/install.sh dans
# /usr/local/share/alarm/standard.env) et par scripts/provision/. Fichier bash (source).
# Changer une valeur ici = changer le standard : meme PR que docs/STANDARD_MACHINE.md.
# Depot public : AUCUN secret ici (ni mot de passe BIOS, ni cle privee).

# Plan des machines standard : machine=NODE_NAME:IP_WireGuard:GATEWAY_SITE (site affiche, INV-161/182).
# Une machine absente du plan (onsite-1/onsite-2 en retrait, NODE3 cloud) n'est pas controlee.
STD_PLAN="alarm-1=node4:10.99.0.4:beaufort alarm-2=node5:10.99.0.5:beaufort alarm-3=node6:10.99.0.6:izeron alarm-4=node7:10.99.0.7:izeron"

# Materiel et BIOS (catalogue Dell downloads.dell.com/catalog/CatalogPC.cab, FOLDER05650490M/1/9020MA19.exe)
STD_MODEL="OptiPlex 9020M"
STD_BIOS_VERSION=A19
STD_BIOS_FILE=9020MA19.exe
STD_BIOS_SIZE=9874896
STD_BIOS_MD5=227f1be2dfcab777d498c02f95dbce28
STD_BIOS_SHA256=6ead68a5423ef181492fee85e0e4c667a67465d40b7a2fbbb4bdf7a78c548a7d
# Decision du proprietaire du 2026-11-06, reversible (F2 > Secure Boot) : enabled | disabled
STD_SECURE_BOOT=enabled

# Systeme
STD_OS_ID=debian
STD_OS_VERSION_ID=13
STD_LAN_IFACE=eno1
STD_RUNTIME_WATCHDOG=30s
STD_DNS_PUBLIC="1.1.1.1 9.9.9.9"

# WireGuard : NODE3 (OVH) seul pair, relais vers 10.99.0.0/24 (infra/onsite/peers.md)
STD_WG_IFACE=wg0
STD_NODE3_PUBKEY=GDN64aY60tBSWKN4qA6GBd/JhistmDP2oF1qN0Xj9gw=
STD_NODE3_ENDPOINT=51.210.105.102:51820
# PersistentKeepalive 25 s : une poignee de main se renouvelle toutes les ~2 min.
STD_WG_HANDSHAKE_MAX_AGE=300

# Units systemd qui doivent etre « enabled »
STD_UNITS="docker chrony ufw fail2ban wg-quick@wg0 alarm-sms-gateway alarm-modem-watchdog alarm-4g-standby alarm-wan-failover alarm-modem-rat alarm-host-sync.timer alarm-gateway-sync.timer alarm-cd-pull.timer alarm-disk-check.timer alarm-node-check.timer"
