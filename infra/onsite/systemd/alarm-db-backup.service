# /etc/systemd/system/alarm-db-backup.service
#
# INV-191 : sauvegarde logique quotidienne de alarm_db (pg_dump depuis un replica sain), verifiee,
# 14 jours sur NODE3, copie sur alarm-1. Lance par alarm-db-backup.timer. Echec -> email + unit failed.
#
# DEPLOIEMENT : uniquement sur NODE3 cloud, a la main comme l'orchestrateur CD (docs/CD_DESIGN.md
# §9quinquies) — PAS pose par install.sh. Pas de [Install] : active uniquement par le timer.

[Unit]
Description=Alarm 2.0 - Sauvegarde quotidienne de la base alarm_db (INV-191)
Documentation=https://github.com/claude-murgat/Alarm2.0/blob/master/docs/CD_DESIGN.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Meme user que l'orchestrateur : groupe docker (pg_dump dans node3-patroni-1), cle SSH vers
# alarm@10.99.0.4, lecture de /opt/alarm/.env.prod.secrets (SMTP de send-alert-email.py).
User=alarm
Group=alarm
# PGPASSWORD (mot de passe de l'utilisateur PostgreSQL `alarm`), fichier root:alarm 640.
# Sans lui : email d'alerte, rien n'est sauvegarde.
EnvironmentFile=-/etc/alarm/db-backup.env
# /var/lib/alarm/db-backup : sauvegardes + verrou, a `alarm` seul (pas de unit root sur ce dossier, INV-141).
StateDirectory=alarm/db-backup
StateDirectoryMode=0700
UMask=0077
# Dump de quelques Mo + copie par WireGuard : large marge avant kill.
TimeoutStartSec=1800
ExecStart=/usr/local/bin/alarm-db-backup
StandardOutput=journal
StandardError=journal
