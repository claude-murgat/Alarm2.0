# /etc/udev/rules.d/99-alarm-arduino-dfu.rules — pose par infra/onsite/install.sh (INV-198).
# Bootloader DFU de l'Arduino UNO R4 Minima : la passerelle (user alarm-gateway, groupe dialout) le programme.
SUBSYSTEM=="usb", ATTR{idVendor}=="2341", ATTR{idProduct}=="0369", GROUP="dialout", MODE="0660"
