# PROD cross-machine — alarm-4 (site izeron, WG 10.99.0.7) — VOTEUR etcd (INV-090, jour du demenagement).
# Nœud d'Izeron (avant le déménagement : LAN Beaufort 172.16.1.121) jusqu'au déménagement (INV-161).
# Cf. docs/PROVISIONING_ONSITE.md §22bis (option D : variabilisation docker-compose)
# et docs/REPLACE_ONSITE_NODE.md (ajout d'un nœud non votant).
# Lancer avec ./scripts/start-prod-node.sh --pull 7 : etcd + Patroni + backend.
# 1er demarrage d'etcd : docs/REPLACE_ONSITE_NODE.md, « Jour du demenagement ».

NODE_NAME=node7
ADVERTISE_HOST=10.99.0.7

BACKEND_PORT=8000
PG_PORT=5432
PATRONI_PORT=8008
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380

# Les 3 etcd voteurs (NODE3, alarm-3, alarm-4) via WG (INV-090, jour du demenagement).
ETCD_HOSTS=10.99.0.1:2379,10.99.0.6:2379,10.99.0.7:2379
# Lu au 1er demarrage d'etcd seulement (le jour J : liste imprimee par `etcdctl member add`).
ETCD_INITIAL_CLUSTER=node3=http://10.99.0.1:2380,node6=http://10.99.0.6:2380,node7=http://10.99.0.7:2380

# node3 cloud d'abord, puis l'autre nœud d'Izeron, puis Beaufort (node4, node5).
PEER_TEST_URLS=http://10.99.0.1:8000,http://10.99.0.6:8000,http://10.99.0.4:8000,http://10.99.0.5:8000

MAILHOG_SMTP_PORT=0
MAILHOG_WEB_PORT=0

# Images Docker pullees depuis GHCR (cf docs/CD_DESIGN.md §1 + PR 1 ci/cd-build-ghcr).
REGISTRY=ghcr.io/claude-murgat
IMAGE_TAG=stable

# SMTP relay Gmail (cf issue #105 + PR #108)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=direction_technique@charlesmurgat.com
SMTP_TIMEOUT=10
