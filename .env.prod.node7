# PROD cross-machine — alarm-4 (site izeron, WG 10.99.0.7) — nœud NON VOTANT etcd.
# Futur nœud d'Izeron, physiquement à Beaufort (LAN 172.16.1.121) jusqu'au déménagement (INV-161).
# Cf. docs/PROVISIONING_ONSITE.md §22bis (option D : variabilisation docker-compose)
# et docs/REPLACE_ONSITE_NODE.md (ajout d'un nœud non votant).
# Lancer avec ./scripts/start-prod-node.sh --pull 7 : Patroni + backend seulement,
# AUCUN conteneur etcd local (up --no-deps patroni backend).

NODE_NAME=node7
ADVERTISE_HOST=10.99.0.7

BACKEND_PORT=8000
PG_PORT=5432
PATRONI_PORT=8008
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380

# Les 3 etcd votants (NODE3, onsite-1, onsite-2) via WG.
ETCD_HOSTS=10.99.0.1:2379,10.99.0.2:2379,10.99.0.3:2379
# Inutilise (pas d'etcd local) ; garde pour que docker compose config reste valide.
ETCD_INITIAL_CLUSTER=node1=http://10.99.0.2:2380,node2=http://10.99.0.3:2380,node3=http://10.99.0.1:2380

# Votants d'abord (node3 cloud, onsite-1, onsite-2), puis les autres non votants (node4 a node7).
PEER_TEST_URLS=http://10.99.0.1:8000,http://10.99.0.2:8000,http://10.99.0.3:8000,http://10.99.0.6:8000,http://10.99.0.4:8000,http://10.99.0.5:8000

MAILHOG_SMTP_PORT=0
MAILHOG_WEB_PORT=0

# Images Docker pullees depuis GHCR (cf docs/CD_DESIGN.md §1 + PR 1 ci/cd-build-ghcr).
REGISTRY=ghcr.io/claude-murgat
IMAGE_TAG=stable

# SMTP relay Gmail (cf issue #105 + PR #108)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=direction_technique@charlesmurgat.com
SMTP_TIMEOUT=10
