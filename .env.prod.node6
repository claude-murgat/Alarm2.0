# PROD cross-machine — alarm-3 (site izeron, WG 10.99.0.6) — VOTEUR etcd (INV-090, 2026-11-05).
# Futur nœud d'Izeron, physiquement à Beaufort (LAN 172.16.1.120) jusqu'au déménagement (INV-161).
# Cf. docs/PROVISIONING_ONSITE.md §22bis (option D : variabilisation docker-compose)
# et docs/REPLACE_ONSITE_NODE.md (ajout d'un nœud non votant).
# Lancer avec ./scripts/start-prod-node.sh --pull 6 : etcd + Patroni + backend, comme node1 a node3.
# 1er demarrage d'etcd : `etcdctl member add` d'abord, puis ETCD_INITIAL_CLUSTER_STATE=existing
# (docs/REPLACE_ONSITE_NODE.md, « Ajouter un voteur »).

NODE_NAME=node6
ADVERTISE_HOST=10.99.0.6

BACKEND_PORT=8000
PG_PORT=5432
PATRONI_PORT=8008
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380

# Les 5 etcd voteurs (NODE3, onsite-1, onsite-2, alarm-3, alarm-4) via WG (INV-090, 2026-11-05).
ETCD_HOSTS=10.99.0.1:2379,10.99.0.2:2379,10.99.0.3:2379,10.99.0.6:2379,10.99.0.7:2379
# Lu au 1er demarrage d'etcd seulement. node6 ajoute avant node7 : etcd exige alors la liste
# imprimee par `etcdctl member add` (4 membres), passee en variable d'environnement.
ETCD_INITIAL_CLUSTER=node1=http://10.99.0.2:2380,node2=http://10.99.0.3:2380,node3=http://10.99.0.1:2380,node6=http://10.99.0.6:2380,node7=http://10.99.0.7:2380

# node3 cloud, onsite-1, onsite-2 d'abord, puis l'autre futur nœud d'Izeron et Beaufort (node4, node5).
PEER_TEST_URLS=http://10.99.0.1:8000,http://10.99.0.2:8000,http://10.99.0.3:8000,http://10.99.0.7:8000,http://10.99.0.4:8000,http://10.99.0.5:8000

MAILHOG_SMTP_PORT=0
MAILHOG_WEB_PORT=0

# Images Docker pullees depuis GHCR (cf docs/CD_DESIGN.md §1 + PR 1 ci/cd-build-ghcr).
REGISTRY=ghcr.io/claude-murgat
IMAGE_TAG=stable

# SMTP relay Gmail (cf issue #105 + PR #108)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=direction_technique@charlesmurgat.com
SMTP_TIMEOUT=10
